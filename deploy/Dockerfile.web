# Site web Next.js en mode production (build puis « next start »).
# NEXT_PUBLIC_API_URL est figé dans le code au moment du build : « /api » veut dire que le navigateur
# appelle l'API par la même adresse que le site (le proxy Caddy route /api vers le service api).
FROM node:20-bookworm-slim

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app/web

COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY web ./

ARG NEXT_PUBLIC_API_URL=/api
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN npm run build

ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "run", "start", "--", "--port", "3000"]
