# Point d'entrée unique : HTTPS automatique et routage site / API.
#   TMS_SITE_ADDRESS     adresse du site (ex. tms.client.fr, ou localhost) ; voir .env.example
# La connexion est gérée par l'application elle-même (comptes, voir docs/INSTALLATION-CLIENT.md § 13) :
# l'API refuse toute requête sans session, sauf la page et les vidéos que reçoit un patient.

# Routage : /api/* part vers l'API (préfixe retiré), tout le reste vers le site.
(upstreams) {
	handle_path /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}

{$TMS_SITE_ADDRESS:localhost} {
	encode zstd gzip

	import upstreams
}
