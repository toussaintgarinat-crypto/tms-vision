# Configuration de l'installation. Copier ce fichier en « .env » (cp .env.example .env), puis le remplir.
# Le fichier .env contient un mot de passe : il n'est jamais envoyé sur GitHub (.gitignore).
# Règle d'écriture : CLE=valeur, sans espace autour du « = ». Valeur entre apostrophes si elle contient « $ ».

# --- Adresse du site -------------------------------------------------------------------------
# Nom de domaine du client (ex. tms.cabinet-martin.fr) : HTTPS automatique (Let's Encrypt), il faut
# que le nom pointe vers le serveur et que les ports 80 et 443 soient ouverts.
# Pour un essai sur la machine elle-même, laisser « localhost » (HTTPS avec certificat local).
TMS_SITE_ADDRESS=localhost
# Adresse complète telle que tapée dans le navigateur (avec https://, sans « / » final).
# Elle sert aux liens envoyés aux patients.
TMS_SITE_URL=https://localhost

# --- Mot de passe du praticien ---------------------------------------------------------------
TMS_BASIC_AUTH_USER=praticien
# Mot de passe haché, entre apostrophes. Le produire avec :
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'LeMotDePasseChoisi'
TMS_BASIC_AUTH_HASH=''

# --- Envoi d'emails aux patients (facultatif) ------------------------------------------------
# « none » : aucun email ne part, le praticien copie le lien affiché à l'écran.
# Sinon : module.chemin:Classe d'un service d'envoi (voir src/tms_vision/mailer.py).
TMS_MAILER=none

# --- Assistant vocal (facultatif, éteint par défaut) -----------------------------------------
# Écoute ce que dit le praticien et pré-remplit la fiche d'activité ; il n'enregistre jamais.
# Fournisseur d'IA, adresse et modèle se choisissent SUR LE SITE : roue ⚙ du bandeau « Assistant
# vocal » dans la fiche d'activité (liste des modèles automatique, Ollama / OpenRouter / autre).
# Les CLÉS, elles, ne se mettent qu'ICI : le site ne les enregistre jamais (et .env n'est jamais
# envoyé sur GitHub). Après modification : docker compose up -d
# Clé du service d'IA en ligne (OpenRouter, OpenAI, DeepSeek…). Inutile pour un modèle local.
# TMS_ASSISTANT_LLM_KEY=
# Clé du service de transcription souveraine, s'il en demande une.
# TMS_TRANSCRIPTION_KEY=
# Valeurs par défaut facultatives (ce qui est choisi sur le site les remplace) :
# TMS_ASSISTANT_LLM_URL=ollama
# TMS_ASSISTANT_MODEL=
# TMS_TRANSCRIPTION_URL=http://host.docker.internal:5700
# TMS_ASSISTANT=off  verrouille l'assistant éteint ; TMS_ASSISTANT=on l'autorise d'office.

# --- Ports (Docker) --------------------------------------------------------------------------
# À changer seulement si 80 ou 443 sont déjà pris sur le serveur.
TMS_HTTP_PORT=80
TMS_HTTPS_PORT=443

# --- Sans Docker (./tms start --prod) --------------------------------------------------------
# TMS_API_PORT=8000
# TMS_WEB_PORT=3000
# Adresse de l'API vue du navigateur, figée dans le site à ./tms build.
# TMS_PUBLIC_API_URL=https://tms.cabinet-martin.fr/api
# ALLOWED_ORIGINS=https://tms.cabinet-martin.fr
# TMS_PUBLIC_WEB_URL=https://tms.cabinet-martin.fr
