  "instructions": [
    {
      "t": 0,
      "text": "Assis sur une chaise, le dos droit, les pieds à plat au sol, les mains sur le bas du dos."
    },
    {
      "t": 5,
      "text": "Penchez doucement le buste vers l'avant, sans forcer."
    },
    {
      "t": 10,
      "text": "Revenez à la verticale."
    },
    {
      "t": 15,
      "text": "Cambrez légèrement le dos vers l'arrière, les mains en soutien."
    },
    {
      "t": 25,
      "text": "Répétez le mouvement lentement, en respirant."
    },
    {
      "t": 40,
      "text": "Terminez en vous redressant et en relâchant les épaules."
    }
