  "instructions": [
    {
      "t": 0,
      "text": "Assis sur une chaise, le dos droit, les pieds à plat au sol, les épaules relâchées."
    },
    {
      "t": 3,
      "text": "Tendez les bras devant vous, les mains libres."
    },
    {
      "t": 8,
      "text": "Pliez les poignets vers le bas."
    },
    {
      "t": 10,
      "text": "Inclinez les mains vers le pouce."
    },
    {
      "t": 12,
      "text": "Relevez les mains vers le haut."
    },
    {
      "t": 14,
      "text": "Inclinez les mains vers le petit doigt."
    },
    {
      "t": 35,
      "text": "Relâchez les bras."
    }
