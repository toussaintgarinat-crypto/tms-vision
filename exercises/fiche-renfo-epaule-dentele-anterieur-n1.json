  "instructions": [
    {
      "t": 0,
      "text": "Mains au mur, bras tendus, ventre gainé, dos non arrondi."
    },
    {
      "t": 3,
      "text": "Sans plier les coudes, poussez le mur : les omoplates s'écartent."
    },
    {
      "t": 5,
      "text": "Tenez 2 secondes, puis relâchez."
    },
    {
